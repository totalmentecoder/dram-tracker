df %>% filter(post == 0) %>% summarise(mean(min_ram_gb))
df %>% filter(post == 1) %>% summarise(mean(min_ram_gb))
ggplot(df_chow, aes(x = time_index, y = min_ram_gb, color = factor(break_dummy))) +
geom_point() +
